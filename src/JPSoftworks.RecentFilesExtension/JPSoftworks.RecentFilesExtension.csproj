<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageManifestPath>$(CmdPalPackageManifest)</PackageManifestPath>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>

    <RuntimeIdentifiers>$(CmdPalRuntimeIdentifiers)</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>

    <PublishProfile Condition="'$(_IsPublishing)' == 'true'">win-$(Platform).pubxml</PublishProfile>
    <DebugType>embedded</DebugType>

    <AssemblyName>$(CmdPalExtensionAssemblyName)</AssemblyName>
    <Company>Jiri Polasek</Company>
    <Copyright>(c) Jiri Polasek</Copyright>
    <NeutralLanguage>$(CmdPalDefaultLanguage)</NeutralLanguage>
    <Product>Recent Files for Command Palette</Product>
    <AssemblyTitle>Recent Files for Command Palette</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <WindowsMetadataReference Include="$(CmdPalSDKPackageDir)\winmd\Microsoft.CommandPalette.Extensions.winmd" Implementation="Microsoft.CommandPalette.Extensions.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.Glob" />
    <PackageReference Include="JPSoftworks.CommandPalette.Extensions.Toolkit" />
    <PackageReference Include="Microsoft.CommandPalette.Extensions" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="Shmuelie.WinRTServer" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <!-- WAP evaluates the app before importing its publish profile, so set Release publish defaults here too. -->
    <PublishAot Condition="'$(PublishAot)' == '' and '$(Configuration)' == 'Release'">true</PublishAot>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == '' and '$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>true</SelfContained>

    <!--
      Serilog 4.3.0 raises IL2067 in its generic object-destructuring path. The toolkit
      logger used here accepts only preformatted strings and exceptions, so that path
      is not used. Keep detailed warnings enabled so every other trim warning remains visible.
    -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2067</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Suppress DynamicallyAccessedMemberTypes.PublicParameterlessConstructor in fallback code path of Windows SDK projection -->
    <WarningsNotAsErrors>IL2081</WarningsNotAsErrors>

    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsAotCompatible>true</IsAotCompatible>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <Target Name="UpdateVersionFromPackageManifest" BeforeTargets="BeforeBuild">
    <XmlPeek XmlInputPath="$(PackageManifestPath)" Query="/appx:Package/appx:Identity/@Version" Namespaces="&lt;Namespace Prefix='appx' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10'/&gt;">
      <Output TaskParameter="Result" PropertyName="appxManifestVersion" />
    </XmlPeek>

    <Message Importance="High" Text="Set project version to match Appx manifest: $(appxManifestVersion)" />

    <PropertyGroup>
      <Version>$(appxManifestVersion)</Version>
    </PropertyGroup>
  </Target>

  <Target Name="KillRunningExecutable" BeforeTargets="Build;Deploy;Publish">
      <PropertyGroup>
          <ExecutableName>$(AssemblyName).exe</ExecutableName>
      </PropertyGroup>

      <Exec Command="taskkill /F /IM $(ExecutableName)" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>

</Project>
